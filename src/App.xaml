<?xml version="1.0" encoding="utf-8" ?>
<Application
    x:Class="BMBusinessStockManagement.App"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <Color x:Key="PageBackgroundColor">#F5F5F5</Color>
            <Color x:Key="PrimaryColor">#3498DB</Color>
            <Color x:Key="SecondaryColor">#2C3E50</Color>
            <Color x:Key="AccentColor">#27AE60</Color>
            <Color x:Key="DangerColor">#E74C3C</Color>

            <Style TargetType="Page" ApplyToDerivedTypes="True">
                <Setter Property="BackgroundColor" Value="{StaticResource PageBackgroundColor}" />
            </Style>

            <Style TargetType="Button" ApplyToDerivedTypes="True">
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="15,10" />
                <Setter Property="FontAttributes" Value="Bold" />
            </Style>

            <Style TargetType="Entry" ApplyToDerivedTypes="True">
                <Setter Property="Padding" Value="10,10" />
                <Setter Property="BackgroundColor" Value="White" />
                <Setter Property="BorderWidth" Value="1" />
                <Setter Property="BorderColor" Value="#E0E0E0" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
