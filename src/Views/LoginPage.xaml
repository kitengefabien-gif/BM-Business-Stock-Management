<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BMBusinessStockManagement.Views.LoginPage"
             Title="Connexion"
             BackgroundColor="#F5F5F5">

    <VerticalStackLayout Padding="20" Spacing="15" VerticalOptions="Center">
        
        <!-- Logo/Title -->
        <Label Text="BM Business Stock"
               FontSize="28"
               FontAttributes="Bold"
               HorizontalTextAlignment="Center"
               TextColor="#2C3E50" />
        
        <Label Text="Gestion de flux de ciment"
               FontSize="14"
               HorizontalTextAlignment="Center"
               TextColor="#7F8C8D"
               Margin="0,0,0,20" />

        <!-- Email Input -->
        <Label Text="Email" FontAttributes="Bold" TextColor="#2C3E50" />
        <Entry x:Name="EmailEntry"
               Text="{Binding Email}"
               Placeholder="votre@email.com"
               Keyboard="Email"
               Margin="0,0,0,10" />

        <!-- Password Input -->
        <Label Text="Mot de passe" FontAttributes="Bold" TextColor="#2C3E50" />
        <Entry x:Name="PasswordEntry"
               Text="{Binding Password}"
               Placeholder="••••••••"
               IsPassword="True"
               Margin="0,0,0,20" />

        <!-- Error Message -->
        <Label Text="{Binding ErrorMessage}"
               TextColor="#E74C3C"
               FontSize="12"
               IsVisible="{Binding ErrorMessage, Converter={StaticResource StringToBoolConverter}}"
               Margin="0,0,0,10" />

        <!-- Login Button -->
        <Button Text="Se connecter"
                Command="{Binding LoginCommand}"
                BackgroundColor="#3498DB"
                TextColor="White"
                FontAttributes="Bold"
                Padding="0,15"
                CornerRadius="8" />

        <!-- Loading Indicator -->
        <ActivityIndicator IsRunning="{Binding IsLoading}"
                          IsVisible="{Binding IsLoading}"
                          Color="#3498DB"
                          Scale="1.5"
                          Margin="0,20,0,0" />
    </VerticalStackLayout>
</ContentPage>
