using Microsoft.Maui.Controls;

namespace BMBusinessStockManagement
{
    public partial class App : Application
    {
        public App()
        {
            InitializeComponent();
            
            // Enregistrer les converters globalement
            RegisterConverters();
        }

        private void RegisterConverters()
        {
            Resources.Add("InvertedBoolConverter", new Converters.InvertedBoolConverter());
            Resources.Add("StringToBoolConverter", new Converters.StringToBoolConverter());
            Resources.Add("EnumToStringConverter", new Converters.EnumToStringConverter());
            Resources.Add("MoneyConverter", new Converters.MoneyConverter());
            Resources.Add("StatusToColorConverter", new Converters.StatusToColorConverter());
            Resources.Add("DateToStringConverter", new Converters.DateToStringConverter());
        }
    }
}
