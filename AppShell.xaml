<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="BM.Business.StockManagement.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <TabBar>
        <ShellContent
            Title="Dashboard"
            Icon="home.png"
            Route="dashboard"
            ContentTemplate="{DataTemplate local:DashboardPage}" />

        <ShellContent
            Title="Camions"
            Icon="truck.png"
            Route="trucks"
            ContentTemplate="{DataTemplate local:TruckFormPage}" />

        <ShellContent
            Title="Stock"
            Icon="box.png"
            Route="stock"
            ContentTemplate="{DataTemplate local:StockManagementPage}" />

        <ShellContent
            Title="Finance"
            Icon="chart.png"
            Route="finance"
            ContentTemplate="{DataTemplate local:FinanceDashboardPage}" />
    </TabBar>

</Shell>
