<Project Sdk="Microsoft.Maui.Sdk">
    <PropertyGroup>
        <TargetFrameworks>net8.0-android;net8.0-ios;net8.0-maccatalyst;net8.0-windows</TargetFrameworks>
        <TargetFrameworks Condition="$([System.Runtime.InteropServices.RuntimeInformation]::IsOSPlatform($([System.Runtime.InteropServices.OSPlatform]::windows)))>net8.0-android;net8.0-windows</TargetFrameworks>
        <TargetFrameworks Condition="$([System.Runtime.InteropServices.RuntimeInformation]::IsOSPlatform($([System.Runtime.InteropServices.OSPlatform]::Linux)))>net8.0-android</TargetFrameworks>
        <TargetFrameworks Condition="$([System.Runtime.InteropServices.RuntimeInformation]::IsOSPlatform($([System.Runtime.InteropServices.OSPlatform]::create('osx'))))>net8.0-ios;net8.0-maccatalyst</TargetFrameworks>
        
        <!-- Display name -->
        <ApplicationTitle>BM Business Stock Management</ApplicationTitle>

        <!-- App Identifier -->
        <ApplicationId>com.bmbusiness.stockmanagement</ApplicationId>
        <ApplicationId Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)'))com.bmbusiness.stockmanagement</ApplicationId>

        <!-- Versions -->
        <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
        <ApplicationVersion>1</ApplicationVersion>

        <!-- Required for C# Hot Reload -->
        <UseHotReload>true</UseHotReload>

        <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">14.2</SupportedOSPlatformVersion>
        <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">13.1</SupportedOSPlatformVersion>
        <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">21.0</SupportedOSPlatformVersion>
        <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
        <AnalysisLevel>latest</AnalysisLevel>
        <AnalysisLevelPerFile>false</AnalysisLevelPerFile>
    </PropertyGroup>

    <ItemGroup>
        <!-- Microsoft MAUI -->
        <PackageReference Include="Microsoft.Maui.Controls" Version="8.0.0" />
        <PackageReference Include="Microsoft.Maui.Controls.Hosting" Version="8.0.0" />

        <!-- Supabase -->
        <PackageReference Include="Supabase" Version="2.7.13" />

        <!-- SQLite -->
        <PackageReference Include="sqlite-net-pcl" Version="3.14.0" />

        <!-- HTTP Client -->
        <PackageReference Include="HttpClientFactory" Version="5.0.0" />

        <!-- JSON -->
        <PackageReference Include="System.Text.Json" Version="8.0.0" />
        <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />

        <!-- Logging -->
        <PackageReference Include="Serilog" Version="3.1.1" />
        <PackageReference Include="Serilog.Sinks.File" Version="5.0.0" />

        <!-- PDF Generation -->
        <PackageReference Include="SelectPdf" Version="23.1.0" />

        <!-- UI Helpers -->
        <PackageReference Include="CommunityToolkit.Mvvm" Version="8.2.2" />

        <!-- Testing -->
        <PackageReference Include="xunit" Version="2.6.2" />
        <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    </ItemGroup>

    <ItemGroup>
        <!-- .NET MAUI font icons (Material Design Icons, etc) -->
        <MauiFont Include="Resources/Fonts/**/*.ttf" />
    </ItemGroup>

</Project>
