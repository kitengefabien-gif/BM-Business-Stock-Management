<?xml version = "1.0" encoding = "UTF-8" ?>
<Application
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="BM.Business.StockManagement.App">
    <Application.Resources>
        <ResourceDictionary>
            <!-- Couleurs Brand -->
            <Color x:Key="PrimaryBlue">#1E3A8A</Color>
            <Color x:Key="SecondaryOrange">#FF8C00</Color>
            <Color x:Key="NeutralGray">#6B7280</Color>
            <Color x:Key="WhiteColor">#FFFFFF</Color>
            <Color x:Key="LightGray">#F3F4F6</Color>
            <Color x:Key="DarkGray">#1F2937</Color>
            <Color x:Key="ErrorRed">#DC2626</Color>
            <Color x:Key="SuccessGreen">#16A34A</Color>
            <Color x:Key="WarningYellow">#EA580C</Color>

            <!-- Polices -->
            <x:Double x:Key="FontSizeBody">14</x:Double>
            <x:Double x:Key="FontSizeSmall">12</x:Double>
            <x:Double x:Key="FontSizeLarge">18</x:Double>
            <x:Double x:Key="FontSizeTitle">24</x:Double>
            <x:Double x:Key="FontSizeHeading">32</x:Double>

            <!-- Espacements -->
            <Thickness x:Key="PaddingSmall">8</Thickness>
            <Thickness x:Key="PaddingMedium">16</Thickness>
            <Thickness x:Key="PaddingLarge">24</Thickness>

            <!-- Styles -->
            <Style TargetType="Label" x:Key="HeadingStyle">
                <Setter Property="FontSize" Value="{StaticResource FontSizeHeading}" />
                <Setter Property="TextColor" Value="{StaticResource PrimaryBlue}" />
                <Setter Property="FontAttributes" Value="Bold" />
            </Style>

            <Style TargetType="Label" x:Key="TitleStyle">
                <Setter Property="FontSize" Value="{StaticResource FontSizeTitle}" />
                <Setter Property="TextColor" Value="{StaticResource DarkGray}" />
                <Setter Property="FontAttributes" Value="Bold" />
            </Style>

            <Style TargetType="Button" x:Key="PrimaryButtonStyle">
                <Setter Property="BackgroundColor" Value="{StaticResource PrimaryBlue}" />
                <Setter Property="TextColor" Value="{StaticResource WhiteColor}" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="{StaticResource PaddingMedium}" />
                <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
                <Setter Property="FontAttributes" Value="Bold" />
            </Style>

            <Style TargetType="Button" x:Key="SecondaryButtonStyle">
                <Setter Property="BackgroundColor" Value="{StaticResource SecondaryOrange}" />
                <Setter Property="TextColor" Value="{StaticResource WhiteColor}" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="{StaticResource PaddingMedium}" />
                <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
            </Style>

        </ResourceDictionary>
    </Application.Resources>
</Application>
